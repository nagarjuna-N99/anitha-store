    "care": {
      "title": "Saree Care Guide",
      "subtitle": "Preserve the beauty and longevity of your handloom treasures",
      "sections": [
        {
          "id": "silk",
          "tab": "Pure Silk",
          "title": "Pure Silk Care (Kanjeevaram & Banarasi)",
          "image": "https://images.unsplash.com/photo-1606293459339-aa5d34a7b0e1?q=80&w=800",
          "alt": "Silk care",
          "show": true,
          "items": [
            {
              "icon": "🫧",
              "title": "Washing",
              "text": "Dry clean only for heavily zari-worked sarees. For plain silks, use mild shampoo in cold water. Do not soak for more than 5 minutes."
            },
            {
              "icon": "💧",
              "title": "Drying",
              "text": "Never wring or twist. Dry in shade, away from direct sunlight to prevent color fading."
            },
            {
              "icon": "🔥",
              "title": "Ironing",
              "text": "Iron on the reverse side using low to medium heat. Place a cotton cloth between the iron and saree."
            },
            {
              "icon": "✨",
              "title": "Special Note",
              "text": "Silk naturally develops a soft sheen over time. Avoid contact with perfumes directly on the fabric."
            }
          ]
        },
        {
          "id": "tussar",
          "tab": "Tussar & Raw Silk",
          "title": "Tussar & Raw Silk Care",
          "image": "https://images.unsplash.com/photo-1617627143750-d86bc21e42bb?q=80&w=800",
          "alt": "Tussar care",
          "show": true,
          "items": [
            {
              "icon": "🫧",
              "title": "Washing",
              "text": "Hand wash gently with mild detergent in cold water. Tussar is delicate; avoid vigorous rubbing."
            },
            {
              "icon": "💧",
              "title": "Drying",
              "text": "Roll in a clean towel to absorb excess water. Dry flat in shade. Never hang wet Tussar."
            },
            {
              "icon": "🌡️",
              "title": "Ironing",
              "text": "Use low heat. Iron while slightly damp for best results. Always iron on the reverse side."
            },
            {
              "icon": "🌿",
              "title": "Natural Texture",
              "text": "Tussar has a natural coarse texture and slubs. This is not a defect but a mark of authentic handloom."
            }
          ]
        },
        {
          "id": "cotton",
          "tab": "Cotton & Khadi",
          "title": "Cotton & Khadi Care",
          "image": "https://images.unsplash.com/photo-1594736797933-d0501ba2fe65?q=80&w=800",
          "alt": "Cotton care",
          "show": true,
          "items": [
            {
              "icon": "🧺",
              "title": "Washing",
              "text": "Machine wash on gentle cycle or hand wash. Khadi may shrink slightly on first wash."
            },
            {
              "icon": "☀️",
              "title": "Drying",
              "text": "Sun drying is acceptable for white cottons. For colored cottons, dry in shade."
            },
            {
              "icon": "🔥",
              "title": "Ironing",
              "text": "Cotton can withstand high heat. Iron while damp for crisp finish."
            },
            {
              "icon": "🌀",
              "title": "Wrinkles",
              "text": "Khadi and handloom cottons wrinkle easily. This is a sign of pure natural fiber."
            }
          ]
        },
        {
          "id": "storage",
          "tab": "Storage Tips",
          "title": "Long-term Storage",
          "image": "https://images.unsplash.com/photo-1583391733958-e04f9715d184?q=80&w=800",
          "alt": "Storage tips",
          "show": true,
          "items": [
            {
              "icon": "📦",
              "title": "Folding",
              "text": "Fold sarees along original lines. Refold every 3-4 months to prevent permanent crease damage."
            },
            {
              "icon": "🌿",
              "title": "Natural Repellents",
              "text": "Use dried neem leaves, lavender sachets, or cedar blocks. Avoid naphthalene balls."
            },
            {
              "icon": "🌬️",
              "title": "Breathing",
              "text": "Store in muslin cloth bags, never plastic. Plastic traps moisture and causes yellowing."
            },
            {
              "icon": "☀️",
              "title": "Airing",
              "text": "Take sarees out once a season. Air them in shade for a few hours to keep fibers fresh."
            }
          ]
        }
      ],
      "show": true
    },
