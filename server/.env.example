# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# Small, fast and cheap model for chat replies. Change here if you want a stronger one.
CLAUDE_MODEL=claude-haiku-5-5
# Hard stop on spend: after this many Claude calls in one (IST) day the bot hands chats to you instead.
MAX_CLAUDE_CALLS_PER_DAY=1500

# ---- WhatsApp Business Cloud API (Meta) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=choose-any-long-random-string
WA_GRAPH_URL=https://graph.facebook.com/v21.0
# Leave empty to run in DRY-RUN mode (nothing is sent to WhatsApp; replies are only logged/shown in the test page)
# Optional: pre-approved template that pings YOU when a customer needs a human. {{1}}=customer, {{2}}=reason
OWNER_ALERT_TEMPLATE=
OWNER_PHONE=91XXXXXXXXXX

# ---- Server ----
PORT=8787
# Long random password for the inbox, the test page and the catalogue upload
ADMIN_TOKEN=change-me-to-a-long-random-string
# Where your store is hosted (used for product links and to allow the store admin to upload the catalogue)
SITE_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com
DATA_DIR=./data

# ---- Abandoned-cart reminders ----
# The store's login service must answer POST {phone, token} -> {"ok":true} so only genuine signed-in customers can save a cart. Required when WhatsApp is live.
CUSTOMER_TOKEN_CHECK_URL=
CART_REMINDERS=on
# minutes: 1st reminder after this much inactivity, 2nd this long after the 1st (max 2 reminders)
CART_REMINDER_DELAYS_MIN=60,1500
CART_REMINDER_MAX_PER_7_DAYS=2
CART_REMINDER_EXPIRE_HOURS=72
# quiet hours, IST: nothing is sent from 21:00 until 09:00
CART_QUIET_FROM_HOUR=21
CART_QUIET_TO_HOUR=9
# Names of your Meta-approved templates (see README) and their language code
CART_TEMPLATE_1=cart_reminder_1
CART_TEMPLATE_2=cart_reminder_2
CART_TEMPLATE_LANG=en

# ---- Orders & payment links ----
# mock = fake test pay page (no account needed). razorpay = Razorpay Payment Links. Other gateways: add a class in src/payments.mjs.
PAYMENT_PROVIDER=mock
# owner = every order waits for you to press "Send payment link" in /inbox. auto = link is sent straight away (stock is checked first).
ORDER_APPROVAL=owner
PAYMENT_LINK_VALID_HOURS=24
# This server's own public https address (payment pages and gateway notifications use it)
PUBLIC_URL=https://assistant.example.com
# Razorpay (only when PAYMENT_PROVIDER=razorpay). Webhook URL to enter in Razorpay: PUBLIC_URL/payments/webhook, events payment_link.paid / expired / cancelled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Approved Meta templates used when the customer last wrote more than 24 hours ago
PAYMENT_LINK_TEMPLATE=payment_link
PAYMENT_CONFIRM_TEMPLATE=payment_received
ORDER_SHIPPED_TEMPLATE=order_shipped

# ---- Delivery, tracking, invoice, reviews ----
# Optional live PIN lookup (India Post style) to catch city/area mistakes; the offline check always runs
PINCODE_LOOKUP=off
PINCODE_LOOKUP_URL=https://api.postalpincode.in/pincode/
# Review request message goes out this many hours after "delivered" (once per order)
REVIEW_REQUEST_AFTER_HOURS=48
# More Meta templates used outside the 24 h window (names must match what you created)
ORDER_PACKED_TEMPLATE=order_packed
ORDER_OUT_FOR_DELIVERY_TEMPLATE=order_out_for_delivery
ORDER_DELIVERED_TEMPLATE=order_delivered
INVOICE_TEMPLATE=invoice_ready
REVIEW_REQUEST_TEMPLATE=review_request

# ---- Owner app (/admin) ----
# The first owner password is created once at https://YOUR-SERVER/admin, using this token. Make it long and random, keep it secret.
# After the account exists you can remove it. If you ever lose your password: delete data/admin.json, set a new token, create the account again.
ADMIN_SETUP_TOKEN=
# Keep on (default) whenever the server is reached over https. Only set to false for local testing on http://localhost.
# COOKIE_SECURE=true
# Optional: only these addresses may even see /admin (comma separated). Everyone else gets a plain 404.
# ADMIN_ALLOWED_IPS=
# ADMIN_TOKEN (above) is the old token for /inbox and /test. With the owner app you do not need it: leave it empty.

# ---- Instagram posting (Instagram Graph API). See HOW-IT-WORKS/17 section 4 ----
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# IG_DAILY_CAP=20
